<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.jason.moneybag.classes.mapper.CourseMapper">

    <resultMap id="BaseResultMap" type="com.jason.moneybag.classes.entity.Course">
            <id property="id" column="ID_" jdbcType="VARCHAR"/>
            <result property="teacherId" column="TEACHER_ID" jdbcType="VARCHAR"/>
            <result property="name" column="NAME_" jdbcType="VARCHAR"/>
            <result property="totalHours" column="TOTAL_HOURS_" jdbcType="INTEGER"/>
            <result property="hoursPerClass" column="HOURS_PER_CLASS" jdbcType="INTEGER"/>
            <result property="finished" column="FINISHED_" jdbcType="TINYINT"/>
            <result property="courseType" column="COURSE_TYPE" jdbcType="VARCHAR"/>
            <result property="createdAt" column="CREATED_AT" jdbcType="TIMESTAMP"/>
            <result property="updatedAt" column="UPDATED_AT" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
        ID_,TEACHER_ID,NAME_,
        TOTAL_HOURS_,HOURS_PER_CLASS,FINISHED_,
        COURSE_TYPE,CREATED_AT,UPDATED_AT
    </sql>
</mapper>
